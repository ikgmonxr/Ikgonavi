--==================================================
-- ANIMACIÓN DE GIRO DEL LOGO
--==================================================
local spinning = true
task.spawn(function()
	while spinning and imagendeelhub and imagendeelhub.Parent do
		local tween = TweenService:Create(
			imagendeelhub,
			TweenInfo.new(1.2, Enum.EasingStyle.Linear),
			{Rotation = imagendeelhub.Rotation + 360}
		)
		tween:Play()
		tween.Completed:Wait()
	end
end)

--==================================================
-- CERRAR INTRO + CARGAR SCRIPT
--==================================================
task.delay(3, function()
	spinning = false

	local fadeTween = TweenService:Create(
		Frame,
		TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
		{BackgroundTransparency = 1}
	)

	for _, child in ipairs(Frame:GetChildren()) do
		if child:IsA("TextLabel") then
			TweenService:Create(child, TweenInfo.new(0.5), {TextTransparency = 1}):Play()
		elseif child:IsA("ImageLabel") then
			TweenService:Create(child, TweenInfo.new(0.5), {
				ImageTransparency = 1,
				Size = UDim2.new(0, 0, 0, 0)
			}):Play()
		end
	end

	fadeTween:Play()
	fadeTween.Completed:Wait()

	ScreenGui:Destroy()

	-- Cargar el Key System de forma segura
	local success, err = pcall(function()
		loadstring(game:HttpGet("https://raw.githubusercontent.com/ikgmonxr/Speed/refs/heads/main/FA"))()
	end)

	if not success then
		warn("[IKGHUB] Error al cargar el script FA:")
		warn(err)
	else
		print("[IKGHUB] Script FA cargado correctamente.")
	end
end)

print("IKGHUB Intro cargada.")
