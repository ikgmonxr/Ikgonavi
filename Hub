local function LocalScript10_fakescript() -- Scriptsbtn.LocalScript
	local script = Instance.new("LocalScript", Scriptsbtn)
	script.Name = "LocalScript"
	local TweenService = game:GetService("TweenService")
	local button = script.Parent
	local frame = button.Parent:WaitForChild("Scripts")
	-- Posición del Frame
	local originalPosition = frame.Position
	-- Tamaño final del Frame
	local originalSize = frame.Size
	-- Configuración de la animación
	local tweenInfo = TweenInfo.new(
		0.4, -- Duración
		Enum.EasingStyle.Quint,
		Enum.EasingDirection.Out
	)
	-- Al inicio, ocultamos el Frame
	frame.Visible = false
	frame.Size = UDim2.new(0, 0, 0, 0)
	button.MouseButton1Click:Connect(function()
		if frame.Visible == false then
			-- Abrir Frame
			frame.Visible = true
			frame.Size = UDim2.new(0, 0, 0, 0)
			local openTween = TweenService:Create(
				frame,
				tweenInfo,
				{
					Size = originalSize
				}
			)
			openTween:Play()
		else
			-- Cerrar Frame
			local closeTween = TweenService:Create(
				frame,
				tweenInfo,
				{
					Size = UDim2.new(0, 0, 0, 0)
				}
			)
			closeTween:Play()
			closeTween.Completed:Connect(function()
				frame.Visible = false
				frame.Size = originalSize
			end)
		end
	end)
end
