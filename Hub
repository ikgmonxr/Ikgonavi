local function LocalScript4_fakescript() -- Enter_your_key__.LocalScript
	local script = Instance.new("LocalScript", Enter_your_key__)
	script.Name = "LocalScript"
	-- // LocalScript - Key System + Carga del HUB con Animación
	-- Colócalo en StarterPlayer > StarterPlayerScripts
	local TweenService = game:GetService("TweenService")
	local keyFrame = script.Parent.Parent -- Frame de la Key (el que se llama KEY)
	local hubFrame = keyFrame.Parent:WaitForChild("IKGHUB") -- Frame del Hub
	local keyBox = keyFrame:WaitForChild("KeyBox")
	local verifyButton = keyFrame:WaitForChild("VerifyButton")
	local statusLabel = keyFrame:FindFirstChild("StatusLabel")
	print("Key System con Animación Activado")
	-- Función para cerrar el KEY Frame con animación
	local function cerrarKeyFrame()
		local tweenInfo = TweenInfo.new(0.6, Enum.EasingStyle.Back, Enum.EasingDirection.In)
		local tween = TweenService:Create(keyFrame, tweenInfo, {
			Size = UDim2.new(0.1, 0, 0.1, 0),
			BackgroundTransparency = 1,
		})
		tween:Play()
		tween.Completed:Connect(function()
			keyFrame.Visible = false
			keyFrame.Size = UDim2.new(0.5, 0, 0.6, 0) -- Vuelve al tamaño original para la próxima vez
			keyFrame.BackgroundTransparency = 0
		end)
	end
	-- Función para verificar la key
	local function verifyKey()
		local key = keyBox.Text
		if key:find("KEY%-FREE%-") then
			print("✅ Key aceptada!")
			if statusLabel then
				statusLabel.Text = "✅ Key correcta! Cargando HUB..."
				statusLabel.TextColor3 = Color3.fromRGB(80, 255, 80)
			end
			task.wait(1)
			-- Cerrar con animación
			cerrarKeyFrame()
			task.wait(0.7)
			-- Mostrar el HUB
			hubFrame.Visible = true
			-- === CARGAR EL HUB ===
			print("Cargando HUB.lua...")
			local success, err = pcall(function()
				loadstring(game:HttpGet("https://raw.githubusercontent.com/ikgmonxr/Speed/refs/heads/main/HUB.lua"))()
			end)
			if success then
				print("✅ HUB cargado correctamente!")
			else
				warn("❌ Error al cargar el HUB: " .. tostring(err))
				if statusLabel then
					statusLabel.Text = "❌ Error al cargar el HUB"
					statusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
				end
			end
		else
			print("❌ Key inválida")
			if statusLabel then
				statusLabel.Text = "❌ La key debe contener KEY-FREE-"
				statusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
			end
		end
	end
	-- Botón Verificar
	verifyButton.MouseButton1Click:Connect(verifyKey)
	-- Presionar Enter en el TextBox
	keyBox.FocusLost:Connect(function(enterPressed)
		if enterPressed then
			verifyKey()
		end
	end)
	print("✅ Key System + Animación listo")
end
